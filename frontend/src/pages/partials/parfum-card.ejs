<article class="parfum-card">

    <!-- Parfum image  -->
    <img src="" alt="">

    <!-- Parfum description -->

    <div class="parfum-card--description">
        <p><%= Rating %></p>

        <p><%= BrandName %></p>


        <<%= headingTag %>> <%= ParfumName %> </<%= headingTag %>>

        <p>Available volumes</p>
        <ul>
          <% items.forEach(item => { %>
            <li><%= item %></li>
          <% }); %>
        </ul>

        <p><%= Price %></p>

        <!-- Currency image -->
        <img src="" alt="">
    </div>

    <<!-- we should use url to get page for this particular id-->>
    <a href="/">View Details</a>

</article>